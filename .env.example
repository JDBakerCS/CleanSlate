GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Find yours at chrome://extensions with Developer mode on (each machine's
# unpacked extension gets a different id unless the manifest pins a key)
EXTENSION_ORIGIN=chrome-extension://<your-unpacked-extension-id>


ENCRYPTION_KEY=

NODE_ENV=development

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

PORT=3000
